<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Electric Vehicle Hub - Gallery</title>
<link rel="stylesheet" href="csslab.css">
</head>
<body>

<header>
    <h1>Vehicle Gallery</h1>
</header>

<nav>
    <a href="index.html">Home</a>
    <a href="vehicles.html">Vehicles</a>
    <a href="register.html">Register</a>
    <a href="gallery.html" class="active">Gallery</a>
    <a href="contact.html">Contact</a>
</nav>

<main>
    <h2>Explore the Fleet</h2>
    <p>Hover over a card to flip it and read more about each vehicle.</p>

    <div class="gallery-grid">

        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="images/tesla3.jpg" alt="Tesla Model 3">
                </div>
                <div class="flip-card-back">
                    <p>Tesla Model 3<br>Range: 576 km</p>
                </div>
            </div>
        </div>

        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="images/bydseal.jpg" alt="BYD Seal">
                </div>
                <div class="flip-card-back">
                    <p>BYD Seal<br>Range: 570 km</p>
                </div>
            </div>
        </div>

        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="images/nissanleaf.jpg" alt="Nissan Leaf">
                </div>
                <div class="flip-card-back">
                    <p>Nissan Leaf<br>Range: 385 km</p>
                </div>
            </div>
        </div>

        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="images/evcharging.jpg" alt="EV charging station">
                </div>
                <div class="flip-card-back">
                    <p>Charging Station<br>Fast charge in minutes</p>
                </div>
            </div>
        </div>

        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="images/evroad.jpg" alt="Electric vehicle on the road">
                </div>
                <div class="flip-card-back">
                    <p>Open Road<br>Smooth, silent driving</p>
                </div>
            </div>
        </div>

        <div class="flip-card">
            <div class="flip-card-inner">
                <div class="flip-card-front">
                    <img src="images/evfuture.jpg" alt="Future electric vehicle concept">
                </div>
                <div class="flip-card-back">
                    <p>The Future<br>Sustainable transport for all</p>
                </div>
            </div>
        </div>

    </div>
</main>

<footer>
    <p>&copy; 2026 Electric Vehicle Hub | Nairobi, Kenya</p>
</footer>

</body>
</html>
